# Backups de base de datos — pesados, no van a control de versiones
*.bak
*.trn
*.mdf
*.ldf
*.ndf

# Archivos locales de SSMS / Visual Studio
*.user
*.suo
*.dtsx.user
.vs/
bin/
obj/

# Configuracion local y credenciales — nunca commitear
# Patrones amplios a proposito: cualquier archivo con "local" en el nombre queda
# fuera. Un patron demasiado especifico (*.local.sql) ya dejo pasar un archivo
# llamado "02_database_mail.local" que contenia una password.
*.local
*.local.*
*local.sql
secrets*
appsettings.Development.json
credentials*
*.key
*.pfx

# Guia de estudio (docs/libro) — solo viajan las fuentes .md y el build.js.
# El HTML pesa ~720 KB, se regenera con "node build.js" y cambia entero en cada
# build: commitear salida generada vuelve los diffs ilegibles.
node_modules/
docs/libro/*.html
